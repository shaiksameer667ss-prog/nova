{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOVA-EVAL Task Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "benchmark_version",
    "task_id",
    "task_version",
    "family",
    "split",
    "status",
    "provenance",
    "environment",
    "verifier",
    "files",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "benchmark": {
      "const": "NOVA-EVAL"
    },
    "benchmark_version": {
      "const": "0.1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "task_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "family": {
      "type": "string",
      "minLength": 2
    },
    "split": {
      "enum": ["development", "validation", "held_out"]
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "VALIDATING",
        "ACCEPTED",
        "REJECTED",
        "RETIRED"
      ]
    },
    "provenance": {
      "type": "object",
      "required": ["origin", "description"],
      "properties": {
        "origin": {
          "enum": ["original", "adapted", "derived"]
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "source_url": {
          "type": "string"
        },
        "source_commit": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["language", "framework"],
      "properties": {
        "language": {"type": "string"},
        "framework": {"type": "string"},
        "python_version": {"type": "string"},
        "dependencies_file": {"type": "string"}
      },
      "additionalProperties": false
    },
    "verifier": {
      "type": "object",
      "required": ["type", "test_path", "timeout_seconds", "version"],
      "properties": {
        "type": {
          "enum": ["pytest", "custom"]
        },
        "test_path": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "V01_starter_rejection",
        "V02_reference_acceptance",
        "V03_incorrect_mutation_rejection",
        "V04_protected_file_integrity",
        "V05_hidden_test_isolation",
        "V06_repeatability",
        "V07_deterministic_scoring",
        "V08_budget_feasibility",
        "V09_no_verifier_leakage",
        "V10_provenance"
      ],
      "properties": {
        "V01_starter_rejection": {"$ref": "#/$defs/gate"},
        "V02_reference_acceptance": {"$ref": "#/$defs/gate"},
        "V03_incorrect_mutation_rejection": {"$ref": "#/$defs/gate"},
        "V04_protected_file_integrity": {"$ref": "#/$defs/gate"},
        "V05_hidden_test_isolation": {"$ref": "#/$defs/gate"},
        "V06_repeatability": {"$ref": "#/$defs/gate"},
        "V07_deterministic_scoring": {"$ref": "#/$defs/gate"},
        "V08_budget_feasibility": {"$ref": "#/$defs/gate"},
        "V09_no_verifier_leakage": {"$ref": "#/$defs/gate"},
        "V10_provenance": {"$ref": "#/$defs/gate"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": ["pass", "fail", "not_run"]
        },
        "evidence": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "ACCEPTED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "V01_starter_rejection": {"properties": {"status": {"const": "pass"}}},
              "V02_reference_acceptance": {"properties": {"status": {"const": "pass"}}},
              "V03_incorrect_mutation_rejection": {"properties": {"status": {"const": "pass"}}},
              "V04_protected_file_integrity": {"properties": {"status": {"const": "pass"}}},
              "V05_hidden_test_isolation": {"properties": {"status": {"const": "pass"}}},
              "V06_repeatability": {"properties": {"status": {"const": "pass"}}},
              "V07_deterministic_scoring": {"properties": {"status": {"const": "pass"}}},
              "V08_budget_feasibility": {"properties": {"status": {"const": "pass"}}},
              "V09_no_verifier_leakage": {"properties": {"status": {"const": "pass"}}},
              "V10_provenance": {"properties": {"status": {"const": "pass"}}}
            }
          }
        }
      }
    }
  ]
}
